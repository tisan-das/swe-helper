{
  "name": "swe-helper",
  "displayName": "swe-helper",
  "description": "Software Engg Expertise for Copilot Chat",
  "version": "0.0.2",
  "publisher": "tisan",
  "repository": {
    "type": "git",
    "url": "https://github.com/tisan-das/swe-helper.git"
  },
  "engines": {
    "vscode": "^1.99.3"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "swe-helper-chat",
        "name": "swe-help",
        "description": "Converse with the selected LLM for code-specific doubts"
      }
    ],
    "commands": [
      {
        "command": "swe-helper-chat.reviewSelectedCode",
        "title": "Review selected code",
        "category": "SWE-Helper"
      },
      {
        "command": "swe-helper-chat.workOnJiraTicket",
        "title": "Work on JIRA ticket (Bug/Feature)",
        "category": "SWE-Helper"
      },
      {
        "command": "swe-helper-chat.generateDiagram",
        "title": "Generate diagram for code",
        "category": "SWE-Helper"
      }
    ],
    "configuration": {
      "title": "SWE Helper",
      "properties": {
        "swe-helper.jiraBaseUrl": {
          "type": "string",
          "default": "",
          "description": "JIRA base URL (e.g., https://yourcompany.atlassian.net)",
          "order": 1
        },
        "swe-helper.jiraEmail": {
          "type": "string",
          "default": "",
          "description": "Your JIRA email address",
          "order": 2
        },
        "swe-helper.jiraApiToken": {
          "type": "string",
          "default": "",
          "description": "Your JIRA API token (generate from https://id.atlassian.com/manage-profile/security/api-tokens)",
          "order": 3
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.99.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "eslint": "^9.36.0",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}